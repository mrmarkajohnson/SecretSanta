@using Application.Areas.Home.ViewModels

@model YearMenuVm
@{
    var giftingGroups = Model.GiftingGroups;
}

@if (giftingGroups?.Any() == true)
{
    int position = 0;

    <a class="btn btn-outline-primary nav-link dropdown-toggle" href="#" id="yearDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        <span class="fa-solid fa-calendar-days" style="color: #9388ff">&nbsp;</span>@Model.CalendarYear
    </a>
    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="yearDropdown">

        @if (giftingGroups.Count > 1)
        {
            <li>
                <a class="dropdown-item" asp-area="@AreaNames.GiftingGroup" asp-controller="Participate" asp-action="Index" asp-route-calendarYear="@Model.CalendarYear">
                    Participate for @Model.CalendarYear
                </a>
            </li>
        }

        <li>
            <a class="dropdown-item" asp-area="@AreaNames.Suggestions" asp-controller="Home" asp-action="Index">
                Manage Suggestions
            </a>
        </li>
        <li>
            <a class="dropdown-item" asp-area="@AreaNames.Suggestions" asp-controller="Home" asp-action="AddSuggestion">
                Add A Suggestion
            </a>
        </li>

        @if (giftingGroups.Count > 1)
        {
            <li><hr class="dropdown-divider"></li>
        }

        @foreach (var giftingGroup in giftingGroups.OrderBy(x => !x.GroupAdmin).ToList())
        {
            position++;

            @if (position > 1 && giftingGroups[position - 2].GroupAdmin)
            {
                <li><hr class="dropdown-divider"></li>
            }

            if (giftingGroup.GroupAdmin)
            {
                <li>
                    <a class="dropdown-item" asp-area="@AreaNames.GiftingGroup" asp-controller="Manage" asp-action="SetupGiftingGroupYear" asp-route-giftingGroupKey="@giftingGroup.GiftingGroupKey"
                            asp-route-calendarYear="@Model.CalendarYear">
                        Set Up Group '@giftingGroup.GroupName' for @Model.CalendarYear
                    </a>
                </li>
            }

            <li>
                <a class="dropdown-item" asp-area="@AreaNames.GiftingGroup" asp-controller="Participate" asp-action="Year" asp-route-giftingGroupKey="@giftingGroup.GiftingGroupKey">
                    View '@giftingGroup.GroupName' for @Model.CalendarYear
                </a>
            </li>
        }
    </ul>

}