@using Application.Areas.Participate.ViewModels
@using Global.Abstractions.Areas.Participate
@using Web.Extensions

@model UserGiftingGroupYearsVm
@{
    Func<IUserGiftingGroupYear, object> actions =
    @<text>
        @if (item.MemberStatus >= GroupMemberStatus.Joined)
        {
            <a asp-action="Year" asp-controller="Participate" asp-area="@AreaNames.GiftingGroup" data-toggle="tooltip" title="View details and participate"
               data-bs-container="td" asp-route-giftingGroupKey="@item.GiftingGroupKey" asp-route-calendarYear="@item.CalendarYear"><i class="fa fa-eye"></i></a>

            @if (item.MemberStatus == GroupMemberStatus.Admin)
            {
                <a asp-action="SetupGiftingGroupYear" asp-controller="Manage" asp-area="@AreaNames.GiftingGroup" asp-route-giftingGroupKey="@item.GiftingGroupKey"
                   asp-route-calendarYear="@item.CalendarYear" data-toggle="tooltip" title="Set Up Group '@item.GiftingGroupName' for @item.CalendarYear"
                   data-bs-container="td"><i class="fa fa-list-check"></i></a>
            }
        }
        else if (item.MemberStatus == GroupMemberStatus.Invited)
        {
            <a asp-action="ReviewInvitation" asp-controller="Manage" asp-area="@AreaNames.GiftingGroup" data-toggle="tooltip" title="Review this invitation"
               data-bs-container="td" asp-route-invitationGuid="@item.InvitationGuid" asp-route-singleInvitation="@true"><i class="fa fa-eye"></i></a>
        }
    </text>;

    Func<IUserGiftingGroupYear, object> recipientName =
    @<text>        
        @if (item.Included && item.Recipient != null)
        {
            <a href="#" data-user-name="@item.RecipientString" data-group-name="@item.GiftingGroupName"
                    data-toggle="tooltip" title="Show who you are giving to this year" data-bs-container="td" onclick="showRecipient(this)">
                Show
            </a>

            <span class="user-info-card collapse">
                <partial name="_UserInfoCard" model="@item.Recipient" view-data="@ViewData.TooltipContainerVd("div.modal")" />
            </span>
        }
        else
        {
            <text>@item.RecipientString</text>
        }
    </text>;

    Func<IUserGiftingGroupYear, object> includedCheckbox =
    @<text>
        <readonly-checkbox for="@item.Included" />
    </text>
    ;

    static string RowClass(IUserGiftingGroupYear item) =>
        item.MemberStatus == GroupMemberStatus.Admin
        ? "bold"
        : (item.MemberStatus <= GroupMemberStatus.Rejected ? "text-grey" : "");
}

@(
Html
    .Grid(Model.UserGiftingGroupYears)
    .Build(columns =>
    {
        columns.Add(x => x.GiftingGroupName).Titled("Group Name");
        columns.Add(x => x.MemberStatus).RenderedAs(x => x.MemberStatus.DisplayName()).Titled(GiftingGroupNames.MemberStatus);
        columns.Add(x => x.Included).RenderedAs(includedCheckbox).Titled($"Participating in {GlobalSettings.CurrentYear}");
        columns.Add(x => x.Limit).RenderedAs(x => x.LimitString).Titled("Spending Limit");
        columns.Add().RenderedAs(recipientName).Titled("Recipient");
        columns.Add().RenderedAs(actions).Titled("Actions").Encoded(false).Css("nowrap");
    })
    .Pageable(pager =>
    {
        pager.PageSizes = new Dictionary<int, string> { { 0, "All" }, { 10, "10" }, { 20, "20" }, { 50, "50" } };
        pager.ShowPageSizes = true;
    })
    .UsingUrl(Url.Action("GiftingGroupsGrid", new { calendarYear = Model.CalendarYear }) ?? "")
    .Empty("No active applications found")
    .Id("gifting-groups-grid")
    .Filterable()
    .Sortable()
    .RowAttributed(x => new { @class = (RowClass(x)) })
)
